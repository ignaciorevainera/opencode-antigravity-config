{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "synthwave84",
    "mode": "system"
  },
  "plugins": [],
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "verbosity": "low",
    "grouping": "auto",
    "new_location": "launch"
  },
  "animations": true,
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "terminal": {
    "copy": "select"
  }
}
