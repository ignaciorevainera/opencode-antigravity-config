# Real generated configs (contain secrets)
opencode/opencode.json
opencode/service.json
antigravity/mcp_config.json

# Env & local secrets
.env
.env.*
!.env.example
*.local.*
**/*.local.*
**/.secrets/

# Auth & credentials
**/auth*.json
**/mcp-auth.json
**/.credentials.yaml
**/credentials.json

# Databases
**/*.db
**/*.db-*
**/*.db-shm
**/*.db-wal

# State, deps, logs
**/node_modules/
**/logs/
**/sessions/
**/storages/
**/projects/
**/sidecars/
**/.git/
**/*.log

# Per-machine sync exclusions
.syncignore
